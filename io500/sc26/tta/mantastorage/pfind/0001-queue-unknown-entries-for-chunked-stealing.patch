+// Stat an entry whose type was not provided by readdir; name is its basename.
+// Non-directories are counted and checked here. Returns 1 if the entry is a
+// directory, which the caller has to traverse, 0 otherwise.
+static int find_do_unknown(char *path, char *name) {
+	struct stat buf;
+
+	if (pfind_dfs_lstat(path, &buf)) {
+		res->errors++;
+		if(opt->verbosity > 1){
+			fprintf(runtime.logfile, "Error stating file: %s\n", path);
+		}
+		return 0;
+	}
+	if (S_ISDIR(buf.st_mode)) {
+		return 1;
+	}
+
+	res->total_files++;
+	// compare values
+	if(opt->name_pattern && regexec(& opt->name_regex, name, 0, NULL, 0) ){
+		if(opt->verbosity >= 2) {
+			printf("Name does not match: %s\n", name);
+		}
+		return 0;
+	}
+	check_buf(buf, name);
+	return 0;
+}
